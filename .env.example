# Start with the credential-free, explicitly labelled demo.
DEMO_MODE=true

# REQUIRED in real-data mode. Generate: openssl rand -hex 32
# Keep this secret identical across serverless functions; changing it expires sessions.
SESSION_SECRET=

# Real directions: https://account.heigit.org/
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# Public OSM infrastructure (no key, shared quotas, not a production SLA).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional: identify your deployment/contact; the app supplies a SafarNav default.
OVERPASS_USER_AGENT="SafarNav/1.0 (OSM infrastructure route planner)"

# Autocomplete is Geoapify, never public Nominatim.
GEOCODING_PROVIDER=geoapify
GEOCODING_API_KEY=
GEOCODING_API_URL=https://api.geoapify.com/v1/geocode/autocomplete

# Browser-visible map style URL. OpenFreeMap requires no key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# If choosing another provider, put its domain-restricted PUBLIC key in the style URL.
# NEXT_PUBLIC_MAP_API_KEY is reserved; not automatically interpolated.
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: no key => computed explanation. With a valid key, Gemini explains the provided route facts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Neon pooled URL for app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Optional partner attribution for documented Uber pickup/destination links.
UBER_CLIENT_ID=

# Use the existing Geoapify key for limited POI evidence when Overpass is down.
# Set to none to disable; requests consume Geoapify Places credits (capped/cached).
INFRASTRUCTURE_FALLBACK=geoapify
